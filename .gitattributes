# Normalize line endings so the repo works the same on Windows and Linux
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.toml text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
