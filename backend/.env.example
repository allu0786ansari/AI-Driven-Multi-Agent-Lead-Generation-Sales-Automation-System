# Copy this file to .env (in the backend folder) and fill in the values.
# Never commit .env - it is in .gitignore.

APP_ENV=development
LOG_LEVEL=INFO
# true = one JSON object per log line; false = easier to read while developing
LOG_JSON=false

# SQLite file for the prototype (created automatically). Postgres later, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leadgen
DATABASE_URL=sqlite:///./data/app.db

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env
JWT_EXPIRE_MINUTES=720

# Meta app (developers.facebook.com > your app > App settings > Basic > App secret)
META_APP_SECRET=change-me-in-env
# Any string you choose; enter the same value in the Meta webhook settings
META_VERIFY_TOKEN=change-me-in-env
META_VERIFY_SIGNATURES=true

# Background worker
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=5

# LLM: "ollama" (real, local) or "fake" (no model needed - for trying things out)
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

CATALOG_PATH=./data/catalog.sample.json

# Leave empty: events are assigned to the only business user
DEFAULT_USER_ID=

# ---- Week 2 ----
# Product search embeddings: "hashing" (no model needed) or "ollama"
# (after choosing a model with: python -m scripts.eval_retrieval --provider ollama --model bge-m3)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=bge-m3

BUSINESS_NAME=Your Store

# "fake" = record messages locally (safe default); "live" = really call Meta/WhatsApp
META_API_MODE=fake
META_GRAPH_VERSION=v25.0
# Page access token with leads_retrieval (for lead forms)
META_PAGE_ACCESS_TOKEN=
# WhatsApp Cloud API (WhatsApp Manager > API setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Lead form question keys (must match your Instant Form)
LEADFORM_OPTIN_FIELD=whatsapp_opt_in
LEADFORM_PRODUCT_FIELD=product_interest
DEFAULT_COUNTRY_CODE=91

# Approved template names
TEMPLATE_LANGUAGE=en
TEMPLATE_LEAD_FORM_WELCOME=lead_form_welcome

# Estimated WhatsApp cost per message in INR - verify against Meta's rate card
WA_RATE_MARKETING_INR=0.8631
WA_RATE_UTILITY_INR=0.12
WA_RATE_SERVICE_INR=0.12
