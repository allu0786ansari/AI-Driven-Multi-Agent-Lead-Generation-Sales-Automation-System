# Copy this file to .env (in the backend folder) and fill in the values.
# Never commit .env - it is in .gitignore.

APP_ENV=development
LOG_LEVEL=INFO
# true = one JSON object per log line; false = easier to read while developing
LOG_JSON=false

# SQLite file for the prototype (created automatically). Postgres later, e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/leadgen
DATABASE_URL=sqlite:///./data/app.db

# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env
JWT_EXPIRE_MINUTES=720

# Meta app (developers.facebook.com > your app > App settings > Basic > App secret)
META_APP_SECRET=change-me-in-env
# Any string you choose; enter the same value in the Meta webhook settings
META_VERIFY_TOKEN=change-me-in-env
META_VERIFY_SIGNATURES=true

# Background worker
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=5
WORKER_BACKOFF_BASE_SECONDS=5

# LLM: "ollama" (real, local) or "fake" (no model needed - for trying things out)
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60

CATALOG_PATH=./data/catalog.sample.json

# Leave empty: events are assigned to the only business user
DEFAULT_USER_ID=

# ---- Week 2 ----
# Product search embeddings: "hashing" (no model needed) or "ollama"
# (after choosing a model with: python -m scripts.eval_retrieval --provider ollama --model bge-m3)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=bge-m3

BUSINESS_NAME=Your Store

# "fake" = record messages locally (safe default); "live" = really call Meta/WhatsApp
META_API_MODE=fake
META_GRAPH_VERSION=v25.0
# Page access token with leads_retrieval (for lead forms)
META_PAGE_ACCESS_TOKEN=
# WhatsApp Cloud API (WhatsApp Manager > API setup)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Lead form question keys (must match your Instant Form)
LEADFORM_OPTIN_FIELD=whatsapp_opt_in
LEADFORM_PRODUCT_FIELD=product_interest
DEFAULT_COUNTRY_CODE=91

# Approved template names
TEMPLATE_LANGUAGE=en
TEMPLATE_LEAD_FORM_WELCOME=lead_form_welcome

# Estimated WhatsApp cost per message in INR - verify against Meta's rate card
WA_RATE_MARKETING_INR=0.8631
WA_RATE_UTILITY_INR=0.12
WA_RATE_SERVICE_INR=0.12

# ---- Week 3 ----
# Instagram / Messenger
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
# graph.facebook.com = Instagram via Facebook Login (default); graph.instagram.com = Instagram Login
INSTAGRAM_API_BASE_URL=https://graph.facebook.com
INSTAGRAM_ACCESS_TOKEN=
COMMENT_PUBLIC_REPLY=true
COMMENT_PUBLIC_REPLY_TEXT=Thanks! We've sent you a message 😊
COMMENT_HIDE_SPAM=true

# Alerts to the salesperson: "log" (log + /api/notifications only) or "live"
ALERTS_MODE=log
ALERT_CHANNELS=email,telegram
DASHBOARD_URL=http://127.0.0.1:8000/docs
# Email (e.g. Gmail: smtp.gmail.com, port 587, an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Telegram: create a bot with @BotFather, then get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lead mirror: off | csv (data/leads_mirror.csv, opens in Excel) | google
SHEETS_MODE=csv
SHEETS_SYNC_SECONDS=60
# For SHEETS_MODE=google: service-account key file and the sheet's ID (from its URL)
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Leads
